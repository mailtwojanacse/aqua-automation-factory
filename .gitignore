# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Secrets - never commit a real .env, only .env.example
.env

# Generated per-run output (prompts, logs, screenshots) - not source
**/output/

# Generated reports - regenerated by the pipeline itself, not source
agent5_execution_selfheal/allure-results/
agent5_execution_selfheal/allure-report/
traceability/report.json
traceability/index.html

# Runtime data - grows locally, not meant to be versioned
dashboard/events.db
dashboard/events.db-wal
dashboard/events.db-shm
dashboard/run.log
orchestrator/.auto_trigger_state.json

# automation_target is its own separate, independently version-controlled
# GitHub repo (the "client repo" stand-in) - never nest it inside this one.
automation_target/

# Local Claude Code tooling config - personal session permissions, not
# durable project policy.
.claude/
.playwright-mcp/

# OS cruft
.DS_Store
Thumbs.db
