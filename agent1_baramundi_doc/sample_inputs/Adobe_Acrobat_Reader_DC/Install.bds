<ACTION type="Comment" level="0" breakpoint="0" ignore_error="0" comment="0" is_included="0" logging_enabled="1">
<DATA>
<VALUE>Detect Acrobat</VALUE>
</DATA>
</ACTION>
<ACTION type="RunEmbeddedScript" level="1" breakpoint="0" ignore_error="0" comment="1" is_included="0" logging_enabled="1">
<DATA>
<SCRIPTLANGUAGE>PowerShell</SCRIPTLANGUAGE>
<RETURNCODES>*</RETURNCODES>
<VARNAME>_DETECTACROBAT</VARNAME>
<SCRIPT>&lt;#
.SYNOPSIS
    Detects whether Adobe Acrobat Pro or Adobe Acrobat Reader is installed.
.DESCRIPTION
    Exit codes:
        0 = Acrobat Reader is installed
        1 = Acrobat Pro is installed
        2 = No Acrobat program is installed
#&gt;

$basePath = Join-Path $env:ProgramFiles &apos;Adobe\Acrobat DC&apos;
$acrobatExe = Join-Path $basePath &apos;Acrobat\Acrobat.exe&apos;

if (-not (Test-Path -LiteralPath $acrobatExe)) {
    exit 2
}

# Marker unique to Acrobat Pro (not present in Reader)
$proMarker = Join-Path $basePath &apos;Acrobat\acrotray.exe&apos;

if (Test-Path -LiteralPath $proMarker) {
    exit 1
}

exit 0
</SCRIPT>
<HIDDENEXECUTION>1</HIDDENEXECUTION>
</DATA>
</ACTION>
