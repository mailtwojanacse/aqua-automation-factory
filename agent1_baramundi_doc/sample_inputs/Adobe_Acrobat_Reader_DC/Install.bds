<ACTION type="CopyFiles" level="4" breakpoint="0" ignore_error="0" comment="0" is_included="0" logging_enabled="1">
<DATA>
<SOURCE>{LDIP}\depot\{SWID}\source\Locale</SOURCE>
<DESTINATION>{%ProgramFiles%}\Adobe\Acrobat DC\Acrobat\Locale</DESTINATION>
<FILES>*</FILES>
<OPTIONS>27</OPTIONS>
</DATA>
</ACTION>
<ACTION type="Comment" level="4" breakpoint="0" ignore_error="0" comment="0" is_included="0" logging_enabled="1">
<DATA>
<VALUE>1h (jedes mst einzeln)</VALUE>
</DATA>
</ACTION>
<ACTION type="RunEmbeddedScript" level="4" breakpoint="0" ignore_error="0" comment="1" is_included="0" logging_enabled="1">
<DATA>
<SCRIPTLANGUAGE>PowerShell</SCRIPTLANGUAGE>
<RETURNCODES>*</RETURNCODES>
<VARNAME>_LANG</VARNAME>
<SCRIPT>&lt;#
.SYNOPSIS
    Extracts all language files from the Adobe Reader MUI installer and copies
    them to the installation directory.
.DESCRIPTION
    Uses &quot;msiexec /a&quot; (administrative install) to extract the full MSI with all
    language transforms applied to a temp folder. Then copies the Locale folder
    tree into the actual installation path.

    This fixes missing Locale\xx_XX directories after a Setup.exe install that
    only installed English.
.NOTES
    Must run elevated (admin/SYSTEM).
#&gt;

param(
    [string]$SourceRoot = &quot;{LDIP}\depot\{SWID}\source&quot;,
    [string]$InstallDir = &quot;${env:ProgramW6432}\Adobe\Acrobat DC&quot;,
    [string]$LogPath = &quot;{LDIP}\logs\{SWID}_Languages_i1.log&quot;
)

$ErrorActionPreference = &apos;Stop&apos;

Start-Transcript -Path $LogPath -Append -Force

# --- Paths ---
$msi        = Join-Path $SourceRoot &apos;AcroPro.msi&apos;
$transforms = Join-Path $SourceRoot &apos;Transforms&apos;
$tempExtract = Join-Path $env:TEMP &apos;AdobeMUI_Extract&apos;

Write-Host &quot;&quot;
Write-Host &quot;Source Root: $SourceRoot&quot;
Write-Host &quot;MSI Path: $msi&quot;
Write-Host &quot;Transforms: $transforms&quot;
Write-Host &quot;Install Dir: $InstallDir&quot;
Write-Host &quot;&quot;

if (-not (Test-Path -LiteralPath $msi)) { throw &quot;MSI not found: $msi&quot; }
if (-not (Test-Path -LiteralPath $transforms)) { throw &quot;Transforms folder not found: $transforms&quot; }

# --- Get all MST files ---
$mstFiles = Get-ChildItem -Path $transforms -Filter &apos;*.mst&apos; | Sort-Object Name
if (-not $mstFiles) { throw &quot;No MST files found in $transforms&quot; }
Write-Host &quot;Found $($mstFiles.Count) language transforms.&quot;

# --- Target Locale folder ---
$targetLocale = Join-Path $InstallDir &apos;Acrobat\Locale&apos;
Write-Host &quot;Target Locale: $targetLocale&quot;

if (-not (Test-Path $targetLocale)) {
    Write-Host &quot;Creating Locale directory: $targetLocale&quot;
    New-Item -ItemType Directory -Path $targetLocale -Force | Out-Null
}

# --- Extract each language transform separately ---
Write-Host &quot;&quot;
Write-Host &quot;Extracting languages...&quot;
$successCount = 0
$failCount = 0

foreach ($mstFile in $mstFiles) {
    $langCode = $mstFile.BaseName
    Write-Host &quot;  Processing $langCode ...&quot; -NoNewline
    
    try {
        # Clean extract folder
        if (Test-Path $tempExtract) {
            Remove-Item $tempExtract -Recurse -Force -ErrorAction Stop
        }
        New-Item -ItemType Directory -Path $tempExtract -Force | Out-Null
        
        # Extract MSI with this transform
        $arguments = @(
            &apos;/a&apos;
            &quot;`&quot;$msi`&quot;&quot;
            &quot;TRANSFORMS=`&quot;$($mstFile.FullName)`&quot;&quot;
            &quot;TARGETDIR=`&quot;$tempExtract`&quot;&quot;
            &apos;/qn&apos;
        )
        
        $proc = Start-Process -FilePath &apos;msiexec.exe&apos; -ArgumentList $arguments -Wait -PassThru -NoNewWindow
        if ($proc.ExitCode -ne 0 -and $proc.ExitCode -ne 3010) {
            Write-Host &quot; ERROR (exit code $($proc.ExitCode))&quot;
            $failCount++
            continue
        }
        
        # Diagnostic: show top-level extracted structure for first language
        if ($successCount -eq 0 -and $failCount -eq 0) {
            Write-Host &quot;&quot;
            Write-Host &quot;  [DEBUG] Extracted structure:&quot;
            Get-ChildItem -Path $tempExtract -Recurse -Directory -Depth 4 | ForEach-Object {
                Write-Host &quot;    $($_.FullName.Replace($tempExtract, &apos;.&apos;))&quot;
            }
            Write-Host &quot;&quot;
            Write-Host &quot;  Processing $langCode ...&quot; -NoNewline
        }
        
        # Find Locale folder recursively
        $extractedLocale = $null
        $localeDirs = Get-ChildItem -Path $tempExtract -Recurse -Directory -Filter &apos;Locale&apos; -ErrorAction SilentlyContinue
        if ($localeDirs) {
            # Prefer the one under an &quot;Acrobat&quot; parent
            $extractedLocale = $localeDirs | Where-Object { $_.Parent.Name -eq &apos;Acrobat&apos; } | Select-Object -First 1
            if (-not $extractedLocale) {
                $extractedLocale = $localeDirs | Select-Object -First 1
            }
            $extractedLocale = $extractedLocale.FullName
        }
        
        if (-not $extractedLocale) {
            Write-Host &quot; ERROR (Locale folder not found in extracted files)&quot;
            $failCount++
            continue
        }
        
        # Copy language directories
        $langDirs = Get-ChildItem -Path $extractedLocale -Directory -ErrorAction SilentlyContinue
        foreach ($langDir in $langDirs) {
            $targetDir = Join-Path $targetLocale $langDir.Name
            if (Test-Path $targetDir) {
                Remove-Item $targetDir -Recurse -Force -ErrorAction SilentlyContinue
            }
            Copy-Item -Path $langDir.FullName -Destination $targetDir -Recurse -Force -ErrorAction Stop
        }
        
        Write-Host &quot; OK&quot;
        $successCount++
    }
    catch {
        Write-Host &quot; ERROR ($_)&quot;
        $failCount++
    }
}

Write-Host &quot;&quot;
Write-Host &quot;Done. Successfully installed $successCount languages, $failCount failed.&quot;

# --- Verify ---
Write-Host &quot;&quot;
Write-Host &quot;Verifying installation...&quot;
if (Test-Path $targetLocale) {
    $installedDirs = Get-ChildItem -Path $targetLocale -Directory -ErrorAction SilentlyContinue
    if ($installedDirs) {
        $installed = ($installedDirs.Name | Sort-Object) -join &apos;, &apos;
        Write-Host &quot;? Installed locales ($($installedDirs.Count)): $installed&quot;
    } else {
        Write-Host &quot;? WARNING: No language directories found in $targetLocale&quot;
    }
} else {
    Write-Host &quot;? ERROR: Target locale directory does not exist: $targetLocale&quot;
}

# --- Cleanup ---
Write-Host &quot;&quot;
Write-Host &quot;Cleaning up temp files...&quot;
try {
    if (Test-Path $tempExtract) {
        Remove-Item $tempExtract -Recurse -Force -ErrorAction Stop
        Write-Host &quot;  ? Removed $tempExtract&quot;
    }
}
catch {
    Write-Host &quot;  WARNING: Could not clean up temp files: $($_.Exception.Message)&quot;
}

Write-Host &quot;&quot;
Write-Host &quot;===== COMPLETE =====&quot;
Write-Host &quot;Log saved to: $LogPath&quot;
Stop-Transcript

exit 0
</SCRIPT>
<HIDDENEXECUTION>1</HIDDENEXECUTION>
</DATA>
</ACTION>
<ACTION type="Comment" level="4" breakpoint="0" ignore_error="0" comment="0" is_included="0" logging_enabled="1">
<DATA>
<VALUE>Alle mst auf einmal</VALUE>
</DATA>
</ACTION>
<ACTION type="RunEmbeddedScript" level="4" breakpoint="0" ignore_error="0" comment="1" is_included="0" logging_enabled="1">
<DATA>
<SCRIPTLANGUAGE>PowerShell</SCRIPTLANGUAGE>
<RETURNCODES>*</RETURNCODES>
<VARNAME>_LANG</VARNAME>
<SCRIPT>&lt;#
.SYNOPSIS
    Extracts all language files from the Adobe Reader MUI installer and copies
    them to the installation directory.
.DESCRIPTION
    Uses &quot;msiexec /a&quot; (administrative install) to extract the full MSI with all
    language transforms applied to a temp folder. Then copies the Locale folder
    tree into the actual installation path.

    This fixes missing Locale\xx_XX directories after a Setup.exe install that
    only installed English.
.NOTES
    Must run elevated (admin/SYSTEM).
#&gt;

param(
    [string]$SourceRoot = &quot;{LDIP}\depot\{SWID}\source&quot;,
    [string]$InstallDir = &quot;${env:ProgramW6432}\Adobe\Acrobat DC&quot;,
    [string]$LogPath = &quot;{LDIP}\logs\{SWID}_Languages_i1.log&quot;
)

$ErrorActionPreference = &apos;Stop&apos;

Start-Transcript -Path $LogPath -Append -Force

# --- Paths ---
$msi        = Join-Path $SourceRoot &apos;AcroPro.msi&apos;
$transforms = Join-Path $SourceRoot &apos;Transforms&apos;
$tempExtract = Join-Path $env:TEMP &apos;AdobeMUI_Extract&apos;

Write-Host &quot;&quot;
Write-Host &quot;Source Root: $SourceRoot&quot;
Write-Host &quot;MSI Path: $msi&quot;
Write-Host &quot;Transforms: $transforms&quot;
Write-Host &quot;Install Dir: $InstallDir&quot;
Write-Host &quot;&quot;

if (-not (Test-Path -LiteralPath $msi)) { throw &quot;MSI not found: $msi&quot; }
if (-not (Test-Path -LiteralPath $transforms)) { throw &quot;Transforms folder not found: $transforms&quot; }

# --- Get all MST files ---
$mstFiles = Get-ChildItem -Path $transforms -Filter &apos;*.mst&apos; | Sort-Object Name
if (-not $mstFiles) { throw &quot;No MST files found in $transforms&quot; }
Write-Host &quot;Found $($mstFiles.Count) language transforms.&quot;

# --- Target Locale folder ---
$targetLocale = Join-Path $InstallDir &apos;Acrobat\Locale&apos;
Write-Host &quot;Target Locale: $targetLocale&quot;

if (-not (Test-Path $targetLocale)) {
    Write-Host &quot;Creating Locale directory: $targetLocale&quot;
    New-Item -ItemType Directory -Path $targetLocale -Force | Out-Null
}

# --- Extract ALL languages in a single msiexec /a call ---
Write-Host &quot;&quot;
Write-Host &quot;Extracting all languages in one pass...&quot;

# Clean extract folder
if (Test-Path $tempExtract) {
    Remove-Item $tempExtract -Recurse -Force
}
New-Item -ItemType Directory -Path $tempExtract -Force | Out-Null

# Build semicolon-separated TRANSFORMS list with all MSTs
$transformsArg = ($mstFiles | ForEach-Object { $_.FullName }) -join &apos;;&apos;

# Single administrative extract with all transforms
$cmdLine = &quot;msiexec.exe /a `&quot;$msi`&quot; TRANSFORMS=`&quot;$transformsArg`&quot; TARGETDIR=`&quot;$tempExtract`&quot; /qn&quot;
Write-Host &quot;  Running msiexec /a with all $($mstFiles.Count) transforms...&quot;
$proc = Start-Process -FilePath &apos;cmd.exe&apos; -ArgumentList &quot;/c $cmdLine&quot; -Wait -PassThru -WindowStyle Hidden

if ($proc.ExitCode -ne 0 -and $proc.ExitCode -ne 3010) {
    Write-Host &quot;  WARNING: msiexec /a exit code $($proc.ExitCode), retrying with individual transforms...&quot;
    
    # Fallback: extract one-by-one (slow but reliable)
    foreach ($mstFile in $mstFiles) {
        $langCode = $mstFile.BaseName
        Write-Host &quot;  Processing $langCode ...&quot; -NoNewline
        
        if (Test-Path $tempExtract) { Remove-Item $tempExtract -Recurse -Force }
        New-Item -ItemType Directory -Path $tempExtract -Force | Out-Null
        
        $retryCount = 0
        $maxRetries = 2
        $exitCode = 1
        
        while ($retryCount -le $maxRetries -and $exitCode -ne 0) {
            $arguments = @(&apos;/a&apos;, &quot;`&quot;$msi`&quot;&quot;, &quot;TRANSFORMS=`&quot;$($mstFile.FullName)`&quot;&quot;, &quot;TARGETDIR=`&quot;$tempExtract`&quot;&quot;, &apos;/qn&apos;)
            $p = Start-Process -FilePath &apos;msiexec.exe&apos; -ArgumentList $arguments -Wait -PassThru -NoNewWindow
            $exitCode = $p.ExitCode
            if ($exitCode -eq 1618) {
                # Another install in progress - wait and retry
                $retryCount++
                Start-Sleep -Seconds 5
            } elseif ($exitCode -ne 0 -and $exitCode -ne 3010) {
                break
            }
        }
        
        if ($exitCode -ne 0 -and $exitCode -ne 3010) {
            Write-Host &quot; ERROR (exit code $exitCode)&quot;
            continue
        }
        
        # Find and copy Locale
        $localeDirs = Get-ChildItem -Path $tempExtract -Recurse -Directory -Filter &apos;Locale&apos; -ErrorAction SilentlyContinue
        $extractedLocale = $localeDirs | Where-Object { $_.Parent.Name -eq &apos;Acrobat&apos; } | Select-Object -First 1
        if (-not $extractedLocale) { $extractedLocale = $localeDirs | Select-Object -First 1 }
        
        if ($extractedLocale) {
            Get-ChildItem -Path $extractedLocale.FullName -Directory -ErrorAction SilentlyContinue | ForEach-Object {
                $targetDir = Join-Path $targetLocale $_.Name
                Copy-Item -Path $_.FullName -Destination $targetDir -Recurse -Force
            }
            Write-Host &quot; OK&quot;
        } else {
            Write-Host &quot; ERROR (Locale not found)&quot;
        }
    }
} else {
    Write-Host &quot;  msiexec /a completed successfully (exit code $($proc.ExitCode))&quot;
    
    # Find Locale folder recursively in extraction
    $localeDirs = Get-ChildItem -Path $tempExtract -Recurse -Directory -Filter &apos;Locale&apos; -ErrorAction SilentlyContinue
    $extractedLocale = $localeDirs | Where-Object { $_.Parent.Name -eq &apos;Acrobat&apos; } | Select-Object -First 1
    if (-not $extractedLocale) { $extractedLocale = $localeDirs | Select-Object -First 1 }
    
    if ($extractedLocale) {
        Write-Host &quot;  Found Locale at: $($extractedLocale.FullName)&quot;
        $langDirs = Get-ChildItem -Path $extractedLocale.FullName -Directory -ErrorAction SilentlyContinue
        foreach ($langDir in $langDirs) {
            $targetDir = Join-Path $targetLocale $langDir.Name
            Copy-Item -Path $langDir.FullName -Destination $targetDir -Recurse -Force
        }
        Write-Host &quot;  Copied $($langDirs.Count) language folders.&quot;
    } else {
        throw &quot;Locale folder not found in extracted files under $tempExtract&quot;
    }
}

Write-Host &quot;&quot;
Write-Host &quot;Extraction complete.&quot;

# --- Verify ---
Write-Host &quot;&quot;
Write-Host &quot;Verifying installation...&quot;
if (Test-Path $targetLocale) {
    $installedDirs = Get-ChildItem -Path $targetLocale -Directory -ErrorAction SilentlyContinue
    if ($installedDirs) {
        $installed = ($installedDirs.Name | Sort-Object) -join &apos;, &apos;
        Write-Host &quot;? Installed locales ($($installedDirs.Count)): $installed&quot;
    } else {
        Write-Host &quot;? WARNING: No language directories found in $targetLocale&quot;
    }
} else {
    Write-Host &quot;? ERROR: Target locale directory does not exist: $targetLocale&quot;
}

# --- Cleanup ---
Write-Host &quot;&quot;
Write-Host &quot;Cleaning up temp files...&quot;
try {
    if (Test-Path $tempExtract) {
        Remove-Item $tempExtract -Recurse -Force -ErrorAction Stop
        Write-Host &quot;  ? Removed $tempExtract&quot;
    }
}
catch {
    Write-Host &quot;  WARNING: Could not clean up temp files: $($_.Exception.Message)&quot;
}

Write-Host &quot;&quot;
Write-Host &quot;===== COMPLETE =====&quot;
Write-Host &quot;Log saved to: $LogPath&quot;
Stop-Transcript

exit 0
</SCRIPT>
<HIDDENEXECUTION>1</HIDDENEXECUTION>
</DATA>
</ACTION>
