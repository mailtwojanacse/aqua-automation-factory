# Copy to .env and fill in. Never commit the real .env.

# Which backend generate() uses - see src/llm_client.py.
#   anthropic_api (default) - calls the real Anthropic API, needs ANTHROPIC_API_KEY below.
#   openai_api               - calls the OpenAI API (ChatGPT), needs OPENAI_API_KEY below.
#   azure_openai              - calls an Azure OpenAI deployment, needs the AZURE_OPENAI_* vars below.
#   claude_cli                - shells out to the already-logged-in `claude` CLI on this
#                              machine, no API key needed. Local dev/demo only.
LLM_BACKEND=anthropic_api

ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Only needed if LLM_BACKEND=openai_api
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Only needed if LLM_BACKEND=azure_openai
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=2024-02-01

# Which Git host's CLI to use - see src/reviewer.py. Must match whatever
# Agent 3/5 are configured with.
#   github (default) - uses `gh`.
#   gitlab            - uses `glab`.
GIT_PROVIDER=github

# --- GitHub only: Agent 4 must review as a DIFFERENT account than whoever
# opened the PR (Agent 3/5) - GitHub refuses to let an account approve its
# own PR. Both accounts must already be authenticated locally
# (`gh auth login`, once per account).
AGENT4_AUTHOR_ACCOUNT=mailtwojanacse
AGENT4_REVIEWER_ACCOUNT=srjanakiraman23

# --- GitLab only: glab has no equivalent of `gh auth switch`. Set this to
# a personal access token for the reviewer identity instead - it's applied
# as a GITLAB_TOKEN override on just the review calls, so there's no global
# auth state to switch (or fail to switch back). Leave blank to review as
# whichever account glab is already logged in as.
AGENT4_REVIEWER_TOKEN=
